---
import { samplePosts } from '../../data/sample-posts';

const posts = samplePosts;

const longMonth = (iso: string) => {
  const d = new Date(`${iso}T00:00:00Z`);
  return d.toLocaleString('en-US', { month: 'long', timeZone: 'UTC' }).toUpperCase();
};
const day = (iso: string) => Number.parseInt(iso.slice(8, 10), 10);
const year = (iso: string) => iso.slice(0, 4);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>spanishgum — issue eleven</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --paper: #f3eada;
        --paper-2: #ece1cd;
        --ink: #1a1714;
        --ink-soft: #3a342c;
        --rule: #1a1714;
        --accent: #b13c20;
        --taupe: #7a6e58;
        --gold: #b48d3a;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: 'Newsreader', 'Iowan Old Style', 'Palatino', Georgia, serif;
        font-size: 17px;
        line-height: 1.55;
        min-height: 100vh;
        font-feature-settings: 'liga', 'kern', 'onum';
        position: relative;
      }
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220' viewBox='0 0 220 220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.10  0 0 0 0 0.09  0 0 0 0 0.08  0 0 0 0.06 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        opacity: 0.85;
        pointer-events: none;
        z-index: 1;
        mix-blend-mode: multiply;
      }
      .page {
        position: relative;
        z-index: 2;
        max-width: 1080px;
        margin: 0 auto;
        padding: 36px 36px 80px;
      }
      @media (max-width: 600px) {
        .page { padding: 22px 22px 60px; }
      }

      /* Folio strip top */
      .folio {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 12px;
        align-items: center;
        font-family: 'Newsreader', serif;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--ink);
        padding-bottom: 14px;
        margin-bottom: 22px;
        border-bottom: 1px solid var(--rule);
        position: relative;
      }
      .folio::after {
        content: '';
        position: absolute;
        left: 0; right: 0; bottom: -3px;
        height: 1px;
        background: var(--rule);
      }
      .folio nav { justify-self: end; }
      .folio nav a { color: var(--ink); text-decoration: none; margin-left: 18px; }
      .folio nav a:hover { color: var(--accent); }
      .folio .center {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 11px;
      }
      .folio .center span.dot {
        width: 4px; height: 4px; border-radius: 50%;
        background: var(--accent);
        display: inline-block;
      }

      /* Masthead */
      .masthead {
        display: grid;
        grid-template-columns: 1fr;
        text-align: center;
        margin: 38px 0 14px;
      }
      .super {
        font-style: italic;
        font-size: 14px;
        letter-spacing: 0.16em;
        color: var(--accent);
        margin: 0 0 10px;
        font-variation-settings: 'opsz' 24, 'wght' 500;
      }
      h1.title {
        font-family: 'Fraunces', 'Bodoni Moda', serif;
        font-variation-settings: 'opsz' 144, 'SOFT' 50, 'wght' 500;
        font-weight: 500;
        font-style: normal;
        font-size: clamp(56px, 13vw, 168px);
        line-height: 0.85;
        letter-spacing: -0.035em;
        margin: 0;
        color: var(--ink);
      }
      h1.title .amp {
        font-style: italic;
        font-variation-settings: 'opsz' 144, 'SOFT' 100, 'wght' 400;
        color: var(--accent);
      }
      .sub {
        font-style: italic;
        font-size: clamp(15px, 1.6vw, 19px);
        margin: 16px 0 0;
        color: var(--ink-soft);
        font-variation-settings: 'opsz' 36, 'wght' 400;
      }
      .byline {
        margin: 14px 0 0;
        font-size: 11px;
        letter-spacing: 0.32em;
        text-transform: uppercase;
      }
      .byline .accent { color: var(--accent); }

      /* Double rule */
      .rule-double {
        height: 0;
        margin: 36px 0 22px;
        border: 0;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        padding-top: 4px;
      }

      /* Lede / two-column intro */
      .lede {
        column-count: 2;
        column-gap: 36px;
        font-size: 18px;
        line-height: 1.55;
        color: var(--ink);
        margin: 0 0 24px;
        text-align: justify;
        hyphens: auto;
      }
      @media (max-width: 720px) {
        .lede { column-count: 1; font-size: 17px; }
      }
      .lede p { margin: 0 0 14px; orphans: 2; widows: 2; }
      .lede p:first-of-type::first-letter {
        font-family: 'Fraunces', serif;
        font-variation-settings: 'opsz' 144, 'SOFT' 50, 'wght' 600;
        font-size: 5.7em;
        line-height: 0.78;
        float: left;
        padding: 6px 12px 0 0;
        color: var(--accent);
        font-style: normal;
      }
      .lede em { color: var(--ink); font-variation-settings: 'opsz' 24, 'wght' 500; }

      /* Asterism ornament */
      .ornament {
        text-align: center;
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-size: 22px;
        letter-spacing: 0.6em;
        color: var(--accent);
        margin: 36px 0;
        line-height: 1;
        user-select: none;
      }

      /* Section heads */
      .section-head {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 16px;
        align-items: end;
        margin: 0 0 22px;
      }
      .section-head .label {
        font-family: 'Fraunces', serif;
        font-variation-settings: 'opsz' 96, 'wght' 600;
        font-size: 28px;
        letter-spacing: -0.01em;
        color: var(--ink);
        line-height: 1;
        padding-bottom: 0;
      }
      .section-head .meta {
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--taupe);
        text-align: right;
        align-self: end;
        line-height: 1;
        padding-bottom: 4px;
      }
      .section-head .filler {
        height: 1px;
        background: var(--rule);
        align-self: end;
        margin-bottom: 6px;
      }

      /* Articles list */
      .entries {
        list-style: none;
        margin: 0 0 32px;
        padding: 0;
      }
      .entry {
        display: grid;
        grid-template-columns: 4ch 1fr 14ch;
        gap: 0 24px;
        padding: 22px 0;
        border-bottom: 1px solid rgba(26, 23, 20, 0.18);
        position: relative;
      }
      .entry:first-child { border-top: 1px solid rgba(26, 23, 20, 0.18); }
      .entry:hover { background: rgba(177, 60, 32, 0.05); }
      .entry .num {
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-variation-settings: 'opsz' 96, 'wght' 400;
        font-size: 32px;
        line-height: 1;
        color: var(--accent);
        padding-top: 4px;
      }
      .entry .body { min-width: 0; }
      .entry h3 {
        font-family: 'Fraunces', serif;
        font-variation-settings: 'opsz' 96, 'wght' 500;
        font-weight: 500;
        font-size: clamp(22px, 2.6vw, 32px);
        line-height: 1.05;
        margin: 0 0 8px;
        letter-spacing: -0.012em;
      }
      .entry h3 a {
        color: var(--ink);
        text-decoration: none;
        background-image: linear-gradient(var(--accent), var(--accent));
        background-size: 0% 1px;
        background-repeat: no-repeat;
        background-position: 0 100%;
        transition: background-size 0.3s ease;
      }
      .entry:hover h3 a {
        background-size: 100% 1px;
        color: var(--accent);
      }
      .entry .deck {
        font-style: italic;
        color: var(--ink-soft);
        font-size: 16px;
        margin: 0 0 10px;
        line-height: 1.4;
        max-width: 58ch;
      }
      .entry .meta-row {
        font-size: 11px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--taupe);
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
      }
      .entry .meta-row .tag { color: var(--ink); }
      .entry .meta-row .tag::before { content: '#'; color: var(--accent); }
      .entry .date-stack {
        text-align: right;
        font-family: 'Fraunces', serif;
        line-height: 1;
        align-self: start;
        padding-top: 6px;
      }
      .entry .date-stack .month {
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--ink);
        margin: 0 0 6px;
      }
      .entry .date-stack .day {
        font-variation-settings: 'opsz' 144, 'wght' 400;
        font-style: italic;
        font-size: 56px;
        color: var(--accent);
        margin: 0;
        line-height: 0.85;
      }
      .entry .date-stack .year {
        font-size: 11px;
        letter-spacing: 0.3em;
        color: var(--taupe);
        margin: 6px 0 0;
      }

      @media (max-width: 720px) {
        .entry { grid-template-columns: 4ch 1fr; }
        .entry .date-stack { display: none; }
        .entry .meta-row::after {
          content: var(--inline-date);
        }
      }

      /* Pull quote */
      .pullquote {
        margin: 56px auto;
        max-width: 38ch;
        text-align: center;
        font-family: 'Fraunces', serif;
        font-variation-settings: 'opsz' 144, 'SOFT' 100, 'wght' 400;
        font-style: italic;
        font-size: clamp(24px, 3.6vw, 38px);
        line-height: 1.18;
        color: var(--ink);
        position: relative;
        padding: 28px 16px;
      }
      .pullquote::before, .pullquote::after {
        content: '';
        display: block;
        width: 80px;
        height: 1px;
        background: var(--rule);
        margin: 0 auto 24px;
      }
      .pullquote::after { margin: 24px auto 0; }
      .pullquote em {
        font-style: normal;
        color: var(--accent);
        font-variation-settings: 'opsz' 144, 'wght' 500;
      }
      .pullquote cite {
        display: block;
        margin-top: 18px;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--taupe);
        font-style: normal;
        font-family: 'Newsreader', serif;
      }

      /* Colophon */
      .colophon {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 24px;
        font-size: 13px;
        color: var(--ink-soft);
        padding-top: 28px;
        border-top: 1px solid var(--rule);
        margin-top: 50px;
      }
      .colophon h4 {
        font-family: 'Fraunces', serif;
        font-variation-settings: 'opsz' 24, 'wght' 600;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin: 0 0 8px;
        color: var(--ink);
      }
      .colophon p { margin: 0; line-height: 1.55; }
      .colophon a { color: var(--accent); text-decoration: none; }
      .colophon a:hover { text-decoration: underline; }

      /* Vertical running text */
      .running {
        position: fixed;
        right: 12px;
        top: 50%;
        transform: translateY(-50%) rotate(180deg);
        writing-mode: vertical-rl;
        font-size: 10px;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: var(--taupe);
        z-index: 5;
        font-feature-settings: 'kern';
      }
      @media (max-width: 1100px) { .running { display: none; } }

      .ampersand {
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-variation-settings: 'opsz' 144, 'SOFT' 100, 'wght' 400;
        color: var(--accent);
      }

      .footnote {
        font-size: 11px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--taupe);
        text-align: center;
        margin: 24px 0 0;
      }
      .footnote .star { color: var(--accent); }
    </style>
  </head>
  <body>
    <div class="running">spanishgum &nbsp;·&nbsp; vol. ii &nbsp;·&nbsp; issue eleven &nbsp;·&nbsp; mmxxvi</div>

    <main class="page">
      <header class="folio">
        <div>VOL. II · No. 11</div>
        <div class="center">
          <span>EST. MMXVII</span>
          <span class="dot" aria-hidden="true"></span>
          <span>2 MAY 2026</span>
          <span class="dot" aria-hidden="true"></span>
          <span>FIVE PIECES</span>
        </div>
        <nav>
          <a href="/designs/">designs</a>
          <a href="/posts/">archive</a>
        </nav>
      </header>

      <section class="masthead">
        <p class="super">— a small periodical of weekend findings —</p>
        <h1 class="title">spanishg<span class="amp">u</span>m</h1>
        <p class="sub">notes from a developer's homelab, written between deploys, edited by no one.</p>
        <p class="byline">Words by <span class="accent">Adam</span> &nbsp;·&nbsp; Set in Fraunces &amp; Newsreader</p>
      </section>

      <hr class="rule-double" />

      <article class="lede">
        <p>
          Welcome to <em>issue eleven</em>. This is a slow newsletter about software, language models, and three small servers that hum quietly in a closet. There is no schedule, no marketing plan, and no growth strategy — only the steady habit of writing things down once they finally make sense.
        </p>
        <p>
          What follows is recent work, in the order it was lived: a defense of running language models on hardware that is too small for them, a year of bare-metal Kubernetes mistakes, an experiment with embeddings that turned into a memory aid, an apology for Tcl, and a budget approach to observability that has somehow held up.
        </p>
      </article>

      <p class="ornament" aria-hidden="true">⁂</p>

      <header class="section-head">
        <span class="label">Entries</span>
        <span class="filler" aria-hidden="true"></span>
        <span class="meta">May 2026 · {posts.length} pieces</span>
      </header>

      <ol class="entries">
        {posts.map((post, i) => (
          <li class="entry">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <div class="body">
              <h3>
                <a href={`/posts/${post.slug}/`}>{post.title}</a>
              </h3>
              <p class="deck">{post.excerpt}</p>
              <p class="meta-row">
                {post.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
                <span>·</span>
                <span>{post.readingMinutes} min read</span>
              </p>
            </div>
            <div class="date-stack">
              <p class="month">{longMonth(post.date).slice(0, 3)}</p>
              <p class="day">{day(post.date)}</p>
              <p class="year">{year(post.date)}</p>
            </div>
          </li>
        ))}
      </ol>

      <blockquote class="pullquote">
        Sometimes the cheap thing is <em>the right thing</em>, and the expensive thing was just the fashionable one.
        <cite>— from "Observability on a $40/month budget"</cite>
      </blockquote>

      <p class="ornament" aria-hidden="true">⁂</p>

      <footer class="colophon">
        <div>
          <h4>Find me</h4>
          <p>
            <a href="https://github.com/spanishgum">github.com/spanishgum</a><br />
            <a href="mailto:spanishgum@gmail.com">spanishgum@gmail.com</a><br />
            <a href="/posts/">/posts &mdash; the full archive</a>
          </p>
        </div>
        <div>
          <h4>Colophon</h4>
          <p>
            Set in Fraunces &amp; Newsreader. Paper grain by SVG turbulence. Built in Astro on a Tuesday.
          </p>
        </div>
        <div>
          <h4>Mast</h4>
          <p>
            Editor-in-chief, junior editor, copy editor, type compositor: <span class="ampersand">A.</span>
          </p>
        </div>
      </footer>

      <p class="footnote"><span class="star">✦</span> &nbsp; FIN. &nbsp; <span class="star">✦</span></p>
    </main>
  </body>
</html>
