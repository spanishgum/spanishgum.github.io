---
import { samplePosts } from '../../data/sample-posts';

const posts = samplePosts;
const [featured, ...rest] = posts;
if (!featured) throw new Error('samplePosts must have at least one entry');
const recent = rest.slice(0, 4);

const homelab = [
  { name: 'kestrel', role: 'k3s · ctrl plane', up: '47d 12h', cpu: 18, status: 'ok' },
  { name: 'sparrow', role: 'k3s · worker', up: '47d 12h', cpu: 62, status: 'ok' },
  { name: 'magpie', role: 'storage · zfs', up: '12d 04h', cpu: 41, status: 'warn' },
];
const stack = [
  'astro',
  'tailwind',
  'typescript',
  'k3s',
  'postgres',
  'rust',
  'tcl',
  'caddy',
  'grafana',
  'prometheus',
  'ollama',
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>spanishgum :: status</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #08101e;
        --bg-2: #0d1626;
        --card: #0f1a2e;
        --card-2: #131f36;
        --border: rgba(148, 163, 184, 0.10);
        --border-strong: rgba(148, 163, 184, 0.18);
        --fg: #e6edf7;
        --fg-dim: #94a3b8;
        --fg-faint: #64748b;
        --emerald: #34d399;
        --emerald-soft: rgba(52, 211, 153, 0.14);
        --amber: #fbbf24;
        --amber-soft: rgba(251, 191, 36, 0.14);
        --violet: #a78bfa;
        --violet-soft: rgba(167, 139, 250, 0.14);
        --rose: #fb7185;
        --cyan: #67e8f9;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: 'Manrope', system-ui, -apple-system, sans-serif;
        font-size: 14px;
        line-height: 1.55;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image:
          radial-gradient(circle at 18% 0%, rgba(52, 211, 153, 0.10), transparent 35%),
          radial-gradient(circle at 96% 8%, rgba(167, 139, 250, 0.10), transparent 35%),
          radial-gradient(circle at 50% 100%, rgba(251, 191, 36, 0.06), transparent 40%);
        pointer-events: none;
        z-index: 0;
      }
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        background-image: radial-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px);
        background-size: 28px 28px;
        background-position: -1px -1px;
        opacity: 0.5;
        pointer-events: none;
        z-index: 0;
        mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
      }

      .shell {
        position: relative;
        z-index: 1;
        max-width: 1280px;
        margin: 0 auto;
        padding: 28px 28px 60px;
      }

      /* Top bar */
      .topbar {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 0 4px 24px;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 12px;
        color: var(--fg-faint);
        border-bottom: 1px solid var(--border);
        margin-bottom: 28px;
      }
      .topbar .glyph {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-variation-settings: 'wdth' 75, 'wght' 800;
        font-size: 18px;
        color: var(--fg);
        letter-spacing: -0.02em;
        line-height: 1;
      }
      .topbar .glyph .dot { color: var(--emerald); }
      .topbar .pill {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        padding: 4px 10px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: rgba(255,255,255,0.02);
        color: var(--fg-dim);
      }
      .topbar .pill .live {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--emerald);
        box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
        animation: pulse 1.8s ease-out infinite;
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.55); }
        70% { box-shadow: 0 0 0 8px rgba(52, 211, 153, 0); }
        100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
      }
      .topbar .spacer { flex: 1; }
      .topbar nav { display: flex; gap: 14px; }
      .topbar nav a { color: var(--fg-dim); text-decoration: none; }
      .topbar nav a:hover { color: var(--fg); }

      /* Hero */
      .hero {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 24px;
        align-items: end;
        margin: 12px 4px 30px;
      }
      .hero h1 {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-variation-settings: 'wdth' 85, 'wght' 600, 'opsz' 96;
        font-size: clamp(40px, 5.6vw, 72px);
        line-height: 0.95;
        letter-spacing: -0.035em;
        margin: 0;
        color: var(--fg);
      }
      .hero h1 .accent {
        font-variation-settings: 'wdth' 100, 'wght' 400, 'opsz' 96;
        font-style: italic;
        color: var(--emerald);
      }
      .hero .sub {
        font-size: 16px;
        color: var(--fg-dim);
        margin: 12px 0 0;
        max-width: 56ch;
      }
      .hero .meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--fg-faint);
        text-align: right;
        line-height: 1.7;
        white-space: nowrap;
      }
      .hero .meta strong { color: var(--fg-dim); font-weight: 500; }
      @media (max-width: 720px) {
        .hero { grid-template-columns: 1fr; }
        .hero .meta { text-align: left; }
      }

      /* Grid */
      .bento {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        grid-auto-rows: minmax(120px, auto);
        gap: 14px;
      }
      @media (max-width: 980px) { .bento { grid-template-columns: repeat(4, 1fr); } }
      @media (max-width: 640px) { .bento { grid-template-columns: repeat(2, 1fr); } }

      .tile {
        position: relative;
        background: linear-gradient(180deg, var(--card-2), var(--card));
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 18px;
        overflow: hidden;
        transition: border-color 0.25s ease, transform 0.25s ease;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .tile::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(255,255,255,0.04), transparent 40%);
        pointer-events: none;
      }
      .tile:hover { border-color: var(--border-strong); transform: translateY(-1px); }

      .tile .label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--fg-faint);
      }
      .tile .label .dot {
        width: 5px; height: 5px; border-radius: 50%;
        background: var(--fg-faint);
      }

      /* Featured */
      .t-featured {
        grid-column: span 4;
        grid-row: span 2;
        background:
          radial-gradient(800px 240px at 0% 100%, var(--emerald-soft), transparent 60%),
          radial-gradient(600px 200px at 100% 0%, var(--violet-soft), transparent 60%),
          linear-gradient(180deg, var(--card-2), var(--card));
        padding: 28px;
      }
      .t-featured .label .dot { background: var(--emerald); animation: pulse 1.8s ease-out infinite; }
      .t-featured .label .live-text { color: var(--emerald); }
      .t-featured h2 {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-variation-settings: 'wdth' 85, 'wght' 500, 'opsz' 96;
        font-size: clamp(28px, 3.6vw, 44px);
        line-height: 1.04;
        letter-spacing: -0.02em;
        margin: 6px 0 8px;
      }
      .t-featured h2 a { color: var(--fg); text-decoration: none; }
      .t-featured h2 a:hover { color: var(--emerald); }
      .t-featured .deck {
        color: var(--fg-dim);
        font-size: 16px;
        line-height: 1.55;
        max-width: 56ch;
        margin: 0;
      }
      .t-featured .row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-top: auto;
        padding-top: 16px;
      }
      .t-featured .chip {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(52, 211, 153, 0.08);
        color: var(--emerald);
        border: 1px solid rgba(52, 211, 153, 0.18);
      }
      .t-featured .meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--fg-faint);
        margin-left: auto;
      }
      @media (max-width: 980px) { .t-featured { grid-column: span 4; grid-row: span 2; } }
      @media (max-width: 640px) { .t-featured { grid-column: span 2; grid-row: span 2; padding: 22px; } }

      /* Now */
      .t-now { grid-column: span 2; grid-row: span 1; }
      .t-now .live-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--emerald);
      }
      .t-now .pulse {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--emerald);
        box-shadow: 0 0 12px var(--emerald);
        animation: pulse 1.8s ease-out infinite;
      }
      .t-now .now-title {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-variation-settings: 'wdth' 85, 'wght' 500;
        font-size: 19px;
        line-height: 1.2;
        margin: 4px 0 0;
        color: var(--fg);
      }
      .t-now .since { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--fg-faint); margin-top: auto; }

      /* Reading */
      .t-reading { grid-column: span 2; grid-row: span 1; }
      .t-reading .book {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-variation-settings: 'wdth' 85, 'wght' 500;
        font-size: 17px;
        line-height: 1.2;
        margin: 4px 0 0;
        color: var(--fg);
      }
      .t-reading .author { color: var(--fg-dim); font-size: 13px; margin: 4px 0 0; }
      .t-reading .progress {
        margin-top: auto;
        height: 4px;
        background: rgba(167, 139, 250, 0.12);
        border-radius: 4px;
        overflow: hidden;
      }
      .t-reading .progress > span {
        display: block;
        height: 100%;
        width: 64%;
        background: linear-gradient(90deg, var(--violet), var(--cyan));
        border-radius: 4px;
      }
      .t-reading .pct {
        display: flex;
        justify-content: space-between;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--fg-faint);
        margin-top: 6px;
      }

      /* Homelab */
      .t-lab { grid-column: span 3; grid-row: span 2; }
      .t-lab ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; flex: 1; }
      .t-lab li {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 10px 12px;
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--border);
        border-radius: 10px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
      }
      .t-lab .status-dot {
        width: 8px; height: 8px; border-radius: 50%;
        position: relative;
      }
      .t-lab .ok { background: var(--emerald); box-shadow: 0 0 8px var(--emerald); }
      .t-lab .warn { background: var(--amber); box-shadow: 0 0 8px var(--amber); }
      .t-lab .err { background: var(--rose); box-shadow: 0 0 8px var(--rose); }
      .t-lab .name { color: var(--fg); font-weight: 600; }
      .t-lab .role { color: var(--fg-faint); font-size: 11px; }
      .t-lab .body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
      .t-lab .stat { text-align: right; color: var(--fg-dim); }
      .t-lab .stat .val { color: var(--fg); }
      .t-lab .stat .small { color: var(--fg-faint); font-size: 10px; }

      /* Recent posts */
      .t-recent { grid-column: span 3; grid-row: span 2; }
      .t-recent ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
      .t-recent li {
        display: grid;
        grid-template-columns: 36px 1fr auto;
        gap: 12px;
        align-items: baseline;
        padding: 12px 4px;
        border-bottom: 1px dashed rgba(148, 163, 184, 0.10);
      }
      .t-recent li:last-child { border-bottom: 0; }
      .t-recent .idx {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--fg-faint);
      }
      .t-recent a {
        color: var(--fg);
        text-decoration: none;
        font-family: 'Bricolage Grotesque', sans-serif;
        font-variation-settings: 'wdth' 90, 'wght' 500;
        font-size: 16px;
        line-height: 1.25;
      }
      .t-recent a:hover { color: var(--emerald); }
      .t-recent .date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--fg-faint);
        white-space: nowrap;
      }

      /* Stack */
      .t-stack { grid-column: span 4; grid-row: span 1; }
      .t-stack .chips { display: flex; flex-wrap: wrap; gap: 6px; }
      .t-stack .chip {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 6px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--border);
        color: var(--fg-dim);
      }
      .t-stack .chip:nth-child(3n) { color: var(--emerald); border-color: rgba(52, 211, 153, 0.25); }
      .t-stack .chip:nth-child(5n) { color: var(--amber); border-color: rgba(251, 191, 36, 0.22); }
      .t-stack .chip:nth-child(7n) { color: var(--violet); border-color: rgba(167, 139, 250, 0.22); }

      /* Coords */
      .t-coords { grid-column: span 2; grid-row: span 1; position: relative; }
      .t-coords::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(148,163,184,0.08) 1px, transparent 1px),
          linear-gradient(90deg, rgba(148,163,184,0.08) 1px, transparent 1px);
        background-size: 16px 16px;
        background-position: 0 0;
        opacity: 0.6;
        pointer-events: none;
        z-index: 0;
        mask-image: radial-gradient(ellipse at 60% 40%, #000 30%, transparent 75%);
      }
      .t-coords .marker {
        position: absolute;
        right: 28%;
        bottom: 36%;
        width: 10px; height: 10px;
        border-radius: 50%;
        background: var(--rose);
        box-shadow: 0 0 0 6px rgba(251, 113, 133, 0.18), 0 0 14px var(--rose);
        z-index: 1;
        animation: pulse 1.8s ease-out infinite;
      }
      .t-coords .coord {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: var(--fg-dim);
        position: relative;
        z-index: 1;
      }
      .t-coords .coord strong { color: var(--fg); font-weight: 500; }
      .t-coords .place {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-variation-settings: 'wdth' 85, 'wght' 500;
        font-size: 18px;
        color: var(--fg);
        margin: 4px 0 0;
        position: relative;
        z-index: 1;
      }

      /* Sockets / footer tile */
      .t-sockets { grid-column: span 3; grid-row: span 1; }
      .t-sockets .links { display: flex; flex-direction: column; gap: 6px; margin-top: auto; }
      .t-sockets .links a {
        display: grid;
        grid-template-columns: 14ch 1fr auto;
        gap: 12px;
        padding: 8px 10px;
        text-decoration: none;
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--fg);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        transition: border-color 0.2s ease;
      }
      .t-sockets .links a:hover { border-color: rgba(52, 211, 153, 0.35); }
      .t-sockets .links a .k { color: var(--fg-faint); }
      .t-sockets .links a .v { color: var(--fg-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .t-sockets .links a .arrow { color: var(--emerald); }

      /* Stats / system tile */
      .t-stats { grid-column: span 1; grid-row: span 1; }
      .t-stats .num {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-variation-settings: 'wdth' 75, 'wght' 600, 'opsz' 96;
        font-size: clamp(36px, 5vw, 56px);
        line-height: 0.9;
        letter-spacing: -0.04em;
        color: var(--fg);
        margin-top: auto;
      }
      .t-stats .unit {
        font-family: 'JetBrains Mono', monospace;
        color: var(--emerald);
        font-size: 12px;
      }

      @media (max-width: 980px) {
        .t-lab, .t-recent { grid-column: span 4; grid-row: auto; }
        .t-stack, .t-sockets { grid-column: span 4; }
        .t-now, .t-reading, .t-coords, .t-stats { grid-column: span 2; }
      }
      @media (max-width: 640px) {
        .t-lab, .t-recent, .t-stack, .t-sockets, .t-now, .t-reading, .t-coords, .t-stats { grid-column: span 2; grid-row: auto; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <span class="glyph">spanishgum<span class="dot">·</span></span>
        <span class="pill"><span class="live" aria-hidden="true"></span> deployed · 02 may 2026</span>
        <span class="pill">v2.0.1</span>
        <span class="pill">tz utc-5</span>
        <span class="spacer"></span>
        <nav>
          <a href="/designs/">designs</a>
          <a href="/posts/">posts</a>
          <a href="https://github.com/spanishgum">github</a>
        </nav>
      </header>

      <section class="hero">
        <div>
          <h1>building, writing,<br /><span class="accent">debugging</span> the homelab.</h1>
          <p class="sub">Adam — software developer, AI tinkerer, occasional sysadmin. This is the dashboard view of a slow blog about figuring things out.</p>
        </div>
        <p class="meta">
          <strong>{posts.length}</strong> posts<br />
          <strong>3</strong> nodes online<br />
          <strong>~14 days</strong> to next post
        </p>
      </section>

      <section class="bento" aria-label="status tiles">
        <article class="tile t-featured">
          <p class="label"><span class="dot" aria-hidden="true"></span> <span class="live-text">latest · still warm</span></p>
          <h2><a href={`/posts/${featured.slug}/`}>{featured.title}</a></h2>
          <p class="deck">{featured.excerpt}</p>
          <div class="row">
            {featured.tags.map((t) => (
              <span class="chip">#{t}</span>
            ))}
            <span class="meta">{featured.readingMinutes} min · {featured.date}</span>
          </div>
        </article>

        <article class="tile t-now">
          <p class="label"><span class="dot" aria-hidden="true"></span> now</p>
          <p class="live-bar"><span class="pulse" aria-hidden="true"></span> currently building</p>
          <p class="now-title">a tiny model that judges<br />my commit messages.</p>
          <p class="since">started · 2026-04-30 · day 3</p>
        </article>

        <article class="tile t-reading">
          <p class="label"><span class="dot" aria-hidden="true" style="background: var(--violet)"></span> reading</p>
          <p class="book">Designing Data-Intensive Applications</p>
          <p class="author">Martin Kleppmann · 2nd ed.</p>
          <div class="progress" aria-hidden="true"><span></span></div>
          <div class="pct"><span>ch. 7 of 12</span><span>64%</span></div>
        </article>

        <article class="tile t-lab">
          <p class="label"><span class="dot" aria-hidden="true" style="background: var(--emerald)"></span> homelab · prod</p>
          <ul>
            {homelab.map((node) => (
              <li>
                <span class={`status-dot ${node.status === 'ok' ? 'ok' : node.status === 'warn' ? 'warn' : 'err'}`} aria-hidden="true"></span>
                <span class="body">
                  <span class="name">{node.name}<span class="role"> · {node.role}</span></span>
                  <span class="role">up {node.up}</span>
                </span>
                <span class="stat">
                  <span class="val">{node.cpu}%</span>
                  <span class="small"> cpu</span>
                </span>
              </li>
            ))}
          </ul>
        </article>

        <article class="tile t-recent">
          <p class="label"><span class="dot" aria-hidden="true"></span> recent posts</p>
          <ul>
            {recent.map((p, i) => (
              <li>
                <span class="idx">0{i + 2}</span>
                <a href={`/posts/${p.slug}/`}>{p.title}</a>
                <span class="date">{p.date.slice(5)}</span>
              </li>
            ))}
          </ul>
        </article>

        <article class="tile t-stack">
          <p class="label"><span class="dot" aria-hidden="true" style="background: var(--amber)"></span> stack · current</p>
          <div class="chips">
            {stack.map((s) => (
              <span class="chip">{s}</span>
            ))}
          </div>
        </article>

        <article class="tile t-coords">
          <p class="label"><span class="dot" aria-hidden="true" style="background: var(--rose)"></span> coordinates</p>
          <span class="marker" aria-hidden="true"></span>
          <p class="place">a closet, somewhere in the midwest</p>
