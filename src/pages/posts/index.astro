---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---
<Base title="posts — spanishgum">
  <header class="masthead">
    <h1>posts</h1>
    <p class="positioning">Field notes on software, AI, and the systems I build.</p>
  </header>

  {posts.length === 0 ? (
    <p class="list-empty">No posts yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <article class="post-entry">
            <p class="meta">
              <span class="date">{fmtDate(post.data.date)}</span>
              {post.data.tags.length > 0 && (
                <span class="tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </span>
              )}
            </p>
            <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
            <p class="excerpt">{post.data.description}</p>
          </article>
        </li>
      ))}
    </ul>
  )}
</Base>
